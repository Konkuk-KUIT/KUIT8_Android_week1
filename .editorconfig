root = true

# KUIT 8기 Android 1주차 미션 저장소의 ktlint 설정이다. PR 을 올리면 CI 의 ./gradlew ktlintCheck 가 이 파일을 읽고 검사한다.
# 1주차에 배운 것(코틀린 기본 문법 · @Composable · Column/Row/Box · Modifier · 비율 · 테마)만으로 스스로 고칠 수 있는 규칙만 켜 두고,
# 아직 안 배운 개념(remember · State · ViewModel · CompositionLocal · 안정성)을 근거로 빨개지는 규칙은 언제 켤지 적어 두고 꺼 뒀다.
# 고치는 법은 대부분 ./gradlew ktlintFormat 한 번이다.

[*.{kt,kts}]

# ── 공통 ──────────────────────────────────────────────────────────────
# 버전이 올라가도 같은 규칙 집합을 쓰도록 코드 스타일을 못 박는다(ktlint 기본값과 같다).
ktlint_code_style = ktlint_official
# Compose 룰셋을 켠다. 개별 규칙은 아래에서 ktlint_compose_<rule-id> = disabled 로 끈다.
ktlint_compose = enabled
# @Composable 함수는 PascalCase 라서 표준 함수 이름 규칙에서 빼 준다. 지우면 컴포저블마다 빨개진다.
ktlint_function_naming_ignore_when_annotated_with = Composable

# ── 표준 규칙 중 유일하게 끄는 것 ──────────────────────────────────────
# 안드로이드 스튜디오가 같은 패키지에서 5개 이상 import 하면 자동으로 `layout.*` 로 바꿔 버린다.
# 그런데 메시지는 "Wildcard import" 한 마디뿐이고 자동수정도 안 된다. 고치려면 코드가 아니라 IDE 설정
# (Settings > Editor > Code Style > Kotlin > Imports > Use single name import) 을 만져야 한다.
ktlint_standard_no-wildcard-imports = disabled

# ── 1주차에 추가로 켜는 규칙 (기본값이 꺼져 있어 여기서 켠다) ────────────
# 중첩이 깊어지면 "안쪽을 private @Composable 로 빼라" 고 알려 준다 = 1주차 "화면 쪼개기" 그대로다.
compose_composable_nesting_depth_enabled = true
# 기본값 3 은 시안을 한 파일에 옮긴 화면(Column > Column > Row > Column > Text)도 잡는다. 4 로 완화한다.
compose_composable_nesting_depth_threshold = 4

# ── 2주차(remember · State)에 켤 것 ───────────────────────────────────
# remember / 리컴포지션을 근거로 지적한다. 1주차엔 그 단어를 모른다.
ktlint_compose_remember-missing-check = disabled
# 상태 호이스팅 개념이라 State 타입을 배운 뒤에 켠다.
ktlint_compose_state-param-check = disabled
# 메시지가 "ComponentState 클래스를 만들어라" 로 끝난다. 1주차가 읽고 손댈 문장이 아니다.
ktlint_compose_mutable-state-param-check = disabled
# movableContentOf · 슬롯 내부 상태 보존은 remember 보다도 뒤 순서다.
ktlint_compose_content-slot-reused = disabled

# ── ViewModel 주차에 켤 것 ────────────────────────────────────────────
# 처방이 "state hoisting 을 고려하라" 한 마디뿐이라 1주차엔 어디로 올릴지 알 수 없다.
ktlint_compose_vm-forwarding-check = disabled
# ktlintFormat 이 고쳐 주는 좋은 규칙이지만 1주차 코드엔 viewModel() 호출이 없다.
ktlint_compose_vm-injection-check = disabled
# LaunchedEffect / DisposableEffect 를 쓰기 시작하는 주차에 켠다. 처방이 전부 안 배운 API 다.
ktlint_compose_lambda-param-in-effect = disabled

# ── 재사용 컴포넌트(슬롯 API)를 가르치는 주차에 켤 것 ────────────────────
# modifier 를 파라미터로 여는 것은 컴포넌트 API 설계다. 지금 켜면 뜻 모르고 한 줄 붙여넣게 된다.
ktlint_compose_modifier-missing-check = disabled
# 마지막 자리를 content 슬롯에 비워 두라는 규칙인데, 순서를 바꾸면 호출부 트레일링 람다가 컴파일 에러가 난다.
ktlint_compose_lambda-param-event-trailing = disabled
# XxxDefaults 객체는 공용 컴포넌트를 만들 때 나온다. 1주차 코드엔 등장하지 않는다.
ktlint_compose_defaults-visibility = disabled
# 커스텀 Modifier 확장을 쓰기 시작하는 주차에. 처방인 Modifier.Node 는 8주차에도 안 배운다.
ktlint_compose_modifier-composed-check = disabled

# ── @Preview 를 정리하는 주차에 켤 것 ──────────────────────────────────
# ktlintFormat 이 private 을 붙여 주지만, 1주차에는 라이브 템플릿 prev 가 만들어 주는 그대로가
# 강의 자료와 같아야 한다. 가시성 수식어를 배우는 주차에 이 줄을 지운다.
ktlint_compose_preview-public-check = disabled

# ── CompositionLocal 주차에 켤 것 ─────────────────────────────────────
# 그때는 아래 allowlist 를 끈 채로 이 줄만 지운다(같은 줄에서 둘이 함께 터진다).
ktlint_compose_compositionlocal-naming = disabled

# ── 계속 끄는 것 ──────────────────────────────────────────────────────
# 해제 방법이 코드 수정이 아니라 .editorconfig 등록이다. 스터디원이 손댈 파일이 아니다.
ktlint_compose_compositionlocal-allowlist = disabled
# 공식 코드랩 그대로인 remember { mutableStateOf(0) } 를 빨갛게 만든다. 근거는 박싱 미세 최적화뿐이다.
ktlint_compose_mutable-state-autoboxing = disabled
# 근거가 안정성 · 리컴포지션인데 처방("List 로 바꿔라")이 한 줄도 없다. State 를 배운 뒤에나 의미가 있다.
ktlint_compose_mutable-params-check = disabled
# movableContentOf 는 8주 커리큘럼 어디에도 없는 고급 API 다.
ktlint_compose_remember-content-missing-check = disabled

# ── 줄을 넣지 않는 것 (기본값이 이미 안전하다. 늘리지 말 것) ──────────────
# compose_preview_naming_enabled        : 켜면 강의용 프리뷰 이름들이 빨개지고 format 이 이름을 바꿔 버린다.
# compose_disallow_unstable_collections : 켜면 fun ProductList(products: List<Product>) 가 위반이 된다.
# compose_disallow_material2            : 프로젝트에 M2 의존성이 없다. M2 가 올라오는 주차에 켜면 된다.
